<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_pos_voucher_tree" model="ir.ui.view">
        <field name="name">pos.voucher.tree</field>
        <field name="model">pos.voucher</field>
        <field name="arch" type="xml">
            <list create="0" delete="0">
                <field name="datetime"/>
                <field name="payment_method_id" optional="hide"/>
                <field name="voucher_code"/>
                <field name="original_amount"/>
                <field name="retention_rate" />
                <field name="retention_amount"/>
                <field name="net_amount"/>
                <field name="pos_session_id" optional="hide"/>
                <field name="pos_order_id" optional="hide"/>
                <field name="pos_payment_id" optional="hide"/>
                <field name="currency_id" column_invisible="True"/>


            </list>
        </field>
    </record>
    <record id="view_pos_voucher_form" model="ir.ui.view">
        <field name="name">pos.voucher.form</field>
        <field name="model">pos.voucher</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="pos_session_id"/>
                            <field name="pos_order_id"/>
                            <field name="pos_payment_id"/>
                            <field name="payment_method_id"/>
                            <field name="datetime"/>
                        </group>
                        <group>
                            <field name="voucher_code"/>
                            <field name="original_amount"/>
                            <field name="retention_rate" />
                            <field name="retention_amount"/>
                            <field name="net_amount"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_pos_voucher_search" model="ir.ui.view">
        <field name="name">pos.voucher.search</field>
        <field name="model">pos.voucher</field>
        <field name="arch" type="xml">
            <search>
                <field name="voucher_code"/>
                <field name="pos_session_id"/>
                <field name="pos_order_id"/>
                <field name="pos_payment_id"/>
                <group expand="0" string="Group By">
                    <filter name="group_by_payment_method" string="Payment Method"
                            context="{'group_by': 'payment_method_id'}"/>
                    <filter name="group_by_payment" string="Payment" context="{'group_by': 'pos_payment_id'}"/>
                    <filter name="group_by_order" string="Order" context="{'group_by': 'pos_order_id'}"/>
                    <filter name="group_by_session" string="Session" context="{'group_by': 'pos_session_id'}"/>
                    <filter name="group_by_date" string="Date" context="{'group_by': 'datetime:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_pos_voucher" model="ir.actions.act_window">
        <field name="name">Meal &amp; Gift Vouchers</field>
        <field name="res_model">pos.voucher</field>
        <field name="view_mode">list,form</field>
        <field name="context">{
            'group_by': 'payment_method_id',
            'search_default_group_by_payment_method': 1
            }
        </field>
    </record>

    <menuitem id="menu_pos_voucher_root"
              name="Meal &amp; Gift Vouchers"
              parent="point_of_sale.menu_point_of_sale"
              action="action_pos_voucher"
              sequence="10"/>
</odoo>
